# Application Settings
APP_NAME=WisdomAI
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# AI Providers
# LLM provider: mock | openai_compatible | ollama
LLM_PROVIDER=mock

# To use local Ollama as the main provider, switch to:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# DeepSeek / OpenAI Compatible API
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
# Complete short/long storyboards require a larger text response; no automatic transport retries.
SCRIPT_LLM_TIMEOUT_SECONDS=600
SCRIPT_LLM_MAX_TOKENS=32768
SCRIPT_LLM_MODEL=
SCRIPT_LLM_THINKING=
# 可独立配置只读审稿模型；空值沿用编剧模型。
SCRIPT_REVIEW_LLM_MODEL=

# Creative-agent role routing. Put real tokens only in local .env (ignored by Git).
# Writer: MiniMax M3 official API.
WRITER_AGENT_PROVIDER=minimax
WRITER_AGENT_API_STYLE=openai_chat_completions
WRITER_AGENT_API_KEY=
WRITER_AGENT_BASE_URL=https://api.minimaxi.com/v1
WRITER_AGENT_ENDPOINT=/chat/completions
WRITER_AGENT_MODEL=MiniMax-M3
# Director: DeepSeek V4.1 Flash. The current canonical API model id is deepseek-flash.
DIRECTOR_AGENT_PROVIDER=deepseek
DIRECTOR_AGENT_API_STYLE=openai_chat_completions
DIRECTOR_AGENT_API_KEY=
DIRECTOR_AGENT_BASE_URL=https://api.deepseek.com/v1
DIRECTOR_AGENT_ENDPOINT=/chat/completions
DIRECTOR_AGENT_MODEL=deepseek-flash

# Local source analysis: keep media offline; optional text-only synthesis through configured writer model.
SOURCE_ANALYSIS_LOW_MEMORY=1
SOURCE_EXPRESSION_SYNTHESIS_PROVIDER=local_qwen
SOURCE_EXPRESSION_LLM_MODEL=
# Video-analysis evidence -> detailed reconstruction script
# The active LLM_MODEL must match this value when running the refiner.
VIDEO_SCRIPT_MODEL=Minimax-M2.7
VIDEO_SCRIPT_TEMPERATURE=0.2

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Database (Default to SQLite for MVP)
DATABASE_URL=sqlite:///./data/wisdom_ai.db

# Redis (Optional for MVP, can be mocked)
REDIS_URL=redis://localhost:6379/0

# Platform APIs (Douyin)
DOUYIN_CLIENT_KEY=your_client_key
DOUYIN_CLIENT_SECRET=your_client_secret
DOUYIN_OAUTH_REDIRECT_URI=http://127.0.0.1:8501
DOUYIN_HOME_URL=https://www.douyin.com/
DOUYIN_CREATOR_BASE_URL=https://creator.douyin.com
DOUYIN_UPLOAD_URL=https://creator.douyin.com/creator-micro/content/upload
DOUYIN_STORAGE_STATE_PATH=./data/browser/douyin/storage_state.json
DOUYIN_USER_DATA_DIR=./data/browser/douyin/user_data
TREND_BROWSER_STORAGE_STATE_PATH=./data/browser/douyin_trend/storage_state.json
TREND_BROWSER_USER_DATA_DIR=./data/browser/douyin_trend/user_data
TREND_DB_PATH=./data/trend_intelligence.db
BROWSER_CHANNEL=
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=0
BROWSER_TIMEOUT_MS=30000

# Account login email verification
# 163 SMTP uses an authorization code, not the mailbox password.
# If you use port 25, keep SMTP_USE_SSL=false. If you use port 465, set SMTP_USE_SSL=true.
SMTP_HOST=smtp.163.com
SMTP_PORT=25
SMTP_USERNAME=your_163_email@163.com
SMTP_PASSWORD=your_163_smtp_authorization_code
SMTP_FROM=your_163_email@163.com
SMTP_USE_SSL=false
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_COOLDOWN_SECONDS=60

# Local admin dashboard session
# Leave SESSION_SECRET empty to generate and persist data/.session_secret automatically.
SESSION_COOKIE_NAME=ai_douyin_session
SESSION_COOKIE_DAYS=30
SESSION_SECRET=

# Storage
STORAGE_ROOT=./data
BOOKS_DIR=./data/books
EXTRACTED_DIR=./data/extracted
VIDEOS_DIR=./data/videos
REF_AUDIO_DIR=./data/ref_audio
CHROMA_PERSIST_DIR=./data/chroma_db
DEFAULT_BGM_PATH=./data/ref_audio/Morning-Routine-Lofi-Study-Music(chosic.com).mp3
TTS_PROVIDER=gpt_sovits

# GPT-SoVITS
GPT_SOVITS_API_URL=http://127.0.0.1:9880
GPT_SOVITS_SDK_ROOT=./GPT_SoVITS
GPT_SOVITS_USE_SDK=true
GPT_SOVITS_ENABLE_HTTP_FALLBACK=false
GPT_SOVITS_DEFAULT_REF_AUDIO=./data/ref_audio/mature_male_ref.wav
GPT_SOVITS_DEFAULT_REF_TEXT=是的，爱和混乱有时候会同时到来，但人最终要学会让自己重新稳定下来。

# ComfyUI background generation
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8190
# ComfyUI 的 main.py 绝对路径；留空则 BackgroundResolver 跳过按需启动
# Windows 示例: D:/AI/ComfyUI/main.py
# Linux 示例:   /opt/ComfyUI/main.py
COMFYUI_MAIN_PATH=
COMFYUI_CHECKPOINT=flux1-schnell-fp8.safetensors
COMFYUI_STEPS=4
COMFYUI_CFG=1.0
ENABLE_BACKGROUND_SCENE_PLANNER=false
BACKGROUND_SCENE_LIBRARY_DIR=data/background_scene_library
BACKGROUND_SCENE_PLANNER_USE_LLM=false
BACKGROUND_SCENE_ANALYSIS_MODEL=

# Seedance 2.5 generation channel: dreamina_cli or byteplus_api
SEEDANCE_PROVIDER=ark_api
# Volcengine Ark; use SEEDANCE_PROVIDER=ark_api to prefer Mini 480p.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDANCE_MODEL=doubao-seedance-2-0-mini-260615
# Optional account-balance queries; separate AK/SK, not ARK_API_KEY.
# IAM permission: BillingCenterReadOnlyAccess (or a narrower balance-query policy).
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
# Official Dreamina CLI. Login state is managed under the current Windows user profile.
DREAMINA_CLI_PATH=data/tools/dreamina/dreamina.exe
DREAMINA_MODEL_VERSION=seedance2.5
DREAMINA_CLI_TIMEOUT_SECONDS=120
DREAMINA_CLI_POLL_INTERVAL_SECONDS=3
# BytePlus LAS channel (only required when SEEDANCE_PROVIDER=byteplus_api)
# Create the key in the same region as the operator endpoint. Never commit a real key.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://operator.las.ap-southeast-1.bytepluses.com/api/v1
SEEDANCE_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_TIMEOUT_SECONDS=120
SEEDANCE_POLL_INTERVAL_SECONDS=5
SEEDANCE_DEFAULT_RATIO=9:16
SEEDANCE_DEFAULT_RESOLUTION=480p
# Local dashboard accounting. Set either or both; 0 means not configured.
SEEDANCE_MONTHLY_BUDGET_USD=0
SEEDANCE_MONTHLY_QUOTA_SECONDS=0
SEEDANCE_ESTIMATED_USD_PER_SECOND_480P=0.2056
SEEDANCE_ESTIMATED_USD_PER_SECOND_720P=0.4621
SEEDANCE_USAGE_REPORT_DIR=data/video_generation/seedance
