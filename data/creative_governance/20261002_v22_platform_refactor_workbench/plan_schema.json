            "type": "string",
            "enum": [
              "画内对白",
              "画外对白",
              "混合对白",
              "无对白"
            ]
          },
          "cut_reason": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "实际对白窗口内嘴部、呼吸、情绪表演；只有此字段承载说话中的表演"
                },
                "script_slot": {
                  "type": "string",
                  "enum": [
                    "before",
                    "during",
                    "after"
                  ],
                  "description": "源剧本段落：before在第一句前；during在第一句完整说完后、其余句前（不是说话期间）；after在全部对白后"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "action",
                    "hold"
                  ]
                },
                "duration_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hold_subject": {
                  "type": "string",
                  "enum": [
                    "",
                    "C01",
                    "C02"
                  ]
                },
                "performance": {
                  "type": "string",
                  "description": "实际对白窗口内嘴部、呼吸、情绪表演；只有此字段承载说话中的表演"
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "move",
                          "gaze",
                          "affect",
                          "sit",
                          "stand",
                          "take",
                          "place",
                          "pass",
                          "face"
                        ]
                      },
                      "actor": {
                        "type": "string",
                        "enum": [
                          "C01",
                          "C02"
                        ]
                      },
                      "target": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "description": "move/sit/stand为动作后具体位置；take为手持位置；place为落点；pass为接收人物；gaze/face为目标；affect为表情"
                      }
                    },
                    "required": [
                      "kind",
                      "actor",
                      "target",
                      "value"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "kind": {
                              "enum": [
                                "take",
                                "place",
                                "pass"
                              ]
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        "then": {
                          "properties": {
                            "target": {
                              "enum": [
                                "P01",
                                "P02"
                              ],
                              "description": "被拿起/放下/交接的移动道具ID，不是桌子等落点"
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "kind": {
                              "const": "sit"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        "then": {
                          "properties": {
                            "target": {
                              "enum": [
                                "E01",
                                "E02",
                                "E03",
                                "E04",
                                "E05",
                                "E06",
                                "E07",
                                "E08",
                                "E09"
                              ],
                              "description": "固定可坐物ID；实际可坐性还需空间前提及语义审核"
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "kind": {
                              "enum": [
                                "move",
                                "gaze",
                                "affect",
                                "face",
                                "stand"
                              ]
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        "then": {
                          "properties": {
                            "target": {
                              "const": ""
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "kind": {
                              "const": "pass"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "enum": [
                                "C01",
                                "C02"
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "required": [
                "id",
                "script_slot",
                "kind",
                "duration_seconds",
                "hold_subject",
                "performance",
                "operations"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "hold"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "properties": {
                      "operations": {
                        "const": []
                      },
                      "hold_subject": {
                        "enum": [
                          "C01",
                          "C02"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "action"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "properties": {
                      "hold_subject": {
                        "const": ""
                      }
                    }
                  }
                }
              ]
