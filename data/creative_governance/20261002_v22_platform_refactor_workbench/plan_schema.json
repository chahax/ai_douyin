            "type": "object",
            "properties": {
              "anchor": {
                "type": "string",
                "description": "实际对白窗口内嘴部、呼吸、情绪表演；只有此字段承载说话中的表演"
              },
              "subject": {
                "type": "string",
                "enum": [
                  "C01",
                  "C02"
                ]
              },
              "meaning": {
                "type": "string",
                "description": "实际对白窗口内嘴部、呼吸、情绪表演；只有此字段承载说话中的表演"
              }
            },
            "required": [
              "anchor",
              "subject",
              "meaning"
            ],
            "additionalProperties": false
          },
          "cut_after_event_id": {
            "type": "string",
