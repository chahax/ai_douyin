  "entries": {
    "Ec825d4205be3-0001": {
      "path": "creative_brief.audience",
      "quote": "喜欢生活情绪短片的成年观众"
    },
    "Ec825d4205be3-0002": {
      "path": "creative_brief.audience_emotion",
      "quote": "先看懂她为什么难拒绝，再替她的选择紧张，最后感到关系发生了真实变化。"
    },
    "Ec825d4205be3-0003": {
      "path": "creative_brief.avoid.0",
      "quote": "用一次开本子或摸包代替习惯性的付出历史"
    },
    "Ec825d4205be3-0004": {
      "path": "creative_brief.avoid.1",
      "quote": "靠陪家人看病等新事故替代原本的关系矛盾"
    },
    "Ec825d4205be3-0005": {
      "path": "creative_brief.avoid.2",
      "quote": "强行争吵、突然完美理解、鸡汤总结"
    },
    "Ec825d4205be3-0006": {
      "path": "creative_brief.avoid.3",
      "quote": "为了沿用动画尾帧而改回手绘风格"
    },
    "Ec825d4205be3-0007": {
      "path": "creative_brief.constraints.0",
      "quote": "观众在拒绝发生前，必须通过自然对白或可见后果知道她过去不止一次替同事加班；只写人物背景不算兑现。"
    },
    "Ec825d4205be3-0008": {
      "path": "creative_brief.constraints.1",
      "quote": "她想离开和担心拒绝的原因要在实际事件中成立。"
    },
    "Ec825d4205be3-0009": {
      "path": "creative_brief.constraints.2",
      "quote": "关键反应的构图和窗口必须写入最终视频提示词。"
    },
    "Ec825d4205be3-0010": {
      "path": "creative_brief.constraints.3",
      "quote": "剧情先按完整故事创作，再拆成生成段；不能为固定八秒切段编造操作。"
    },
    "Ec825d4205be3-0011": {
      "path": "creative_brief.duration_policy",
      "quote": "flexible"
    },
    "Ec825d4205be3-0012": {
      "path": "creative_brief.duration_seconds.0",
      "quote": "45"
    },
    "Ec825d4205be3-0013": {
      "path": "creative_brief.duration_seconds.1",
      "quote": "60"
    },
    "Ec825d4205be3-0014": {
      "path": "creative_brief.ending",
      "quote": "以新的行动兑现边界及关系变化；不预先规定两人必须和解，不用主题口号收尾。"
    },
    "Ec825d4205be3-0015": {
      "path": "creative_brief.relationships",
      "quote": "方澄与同事林屿；林屿已习惯她会答应，方澄担心拒绝会伤及两人的关系。"
    },
    "Ec825d4205be3-0016": {
      "path": "creative_brief.theme",
      "quote": "总替同事收尾的人，第一次把自己的时间放在前面"
    },
    "Ec825d4205be3-0017": {
      "path": "creative_brief.turn",
      "quote": "对方原本把她的帮忙视为理所当然；她明确拒绝后，对方必须面对这一点，再通过具体行动回应。"
    },
    "Ec825d4205be3-0018": {
      "path": "creative_brief.visual_style",
      "quote": "写实真人实拍质感的AI短片，成年普通人外貌，真实皮肤纹理、自然光与生活化服装，克制自然表演，关键反应使用可读近景。"
    },
    "Ec825d4205be3-0019": {
      "path": "script.beats.0.after",
      "quote": "林屿说完没抬头，签字笔笔尖重新落到A4横版客户明细单上对数字。"
    },
    "Ec825d4205be3-0020": {
      "path": "script.beats.0.before",
      "quote": "傍晚办公室里，方澄走到林屿桌边，弯腰伸手把滑到桌沿的白色陶瓷马克杯端回林屿桌中央。"
    },
    "Ec825d4205be3-0021": {
