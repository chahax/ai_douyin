      "speaker": "narrator",
      "speaker_name": "旁白",
      "text": "晚上加班时，李婷接到一个陌生境外来电。",
      "audio_path": "data\\qa\\anti_fraud_police_chibi_v1\\old\\final\\anti_fraud_police_old_raw.story\\audio\\scene_000_line_000_narrator_f4a1e8cfcebf.mp3",
